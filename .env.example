# Salin jadi .env lalu isi — JANGAN commit file .env asli!
APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=inotal_partner
DB_SSLMODE=disable

JWT_SECRET=ganti-dengan-string-random-panjang
JWT_EXPIRE_HOURS=24

# Opsional — kosong dulu, login Google dimatikan otomatis kalau tidak diisi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
